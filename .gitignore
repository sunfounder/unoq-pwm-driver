# Build / probe scratch
.probe/
build/
*.o
*.d
*.elf
*.bin
*.hex
*.map

# Arduino sketch build output
**/build/

# Editors
.vscode/
.idea/
*.swp

# Library sources copied into the App Lab sketch by deploy.ps1.
# The canonical copies live in src/. Every file the library ships starts with
# Hardware, so a glob here cannot miss a newly added file.
applab/sketch/Hardware*.h
applab/sketch/Hardware*.cpp

# Local development tools, not part of the distributed library.
# They stay on disk, they are just never committed.
deploy.ps1
keywords.txt
